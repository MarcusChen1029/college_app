{
  "manifest_version": 3,
  "name": "Common App filler",
  "version": "0.1.0",
  "description": "Fills the Common App courses and grades section from your College Tracker transcript.",
  "key": "",
  "permissions": ["identity", "storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://apply.commonapp.org/*",
    "https://eyvmtaggayqizllaseiu.supabase.co/*"
  ],
  "action": { "default_title": "Common App filler" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://apply.commonapp.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
