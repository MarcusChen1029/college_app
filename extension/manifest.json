{
  "manifest_version": 3,
  "name": "College application filler",
  "version": "0.1.0",
  "description": "Fills your courses and grades into Common App, UC, STARS, Cal State Apply, UIUC and UT Austin from your College Tracker transcript.",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://apply.commonapp.org/*",
    "https://apply.universityofcalifornia.edu/*",
    "https://srar.selfreportedtranscript.com/*",
    "https://calstate.cas.myliaison.com/*",
    "https://calstate.liaisoncas.com/*",
    "https://myillini.illinois.edu/*",
    "https://utdirect.utexas.edu/*",
    "https://mystatus.admissions.utexas.edu/*",
    "https://admissions.utexas.edu/*",
    "https://eyvmtaggayqizllaseiu.supabase.co/*"
  ],
  "action": {
    "default_title": "College application filler"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://apply.commonapp.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://apply.universityofcalifornia.edu/*",
        "https://srar.selfreportedtranscript.com/*",
        "https://calstate.cas.myliaison.com/*",
        "https://calstate.liaisoncas.com/*",
        "https://myillini.illinois.edu/*",
        "https://utdirect.utexas.edu/*",
        "https://mystatus.admissions.utexas.edu/*",
        "https://admissions.utexas.edu/*"
      ],
      "js": [
        "assist-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
